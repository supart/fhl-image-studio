    {
      "id": "responses-openai-verbatim",
      "request": {
        "apiProfileId": "profile-fixture-responses",
        "apiMode": "responses",
        "mode": "generate",
        "baseURL": "https://upstream.example/v1/",
        "prompt": "fixture red square",
        "size": "1024x1024",
        "quality": "auto",
        "outputFormat": "png",
        "textModelID": "fixture-text-model",
        "imageModelID": "fixture-image-model",
        "requestPolicy": "openai",
        "noPromptRevision": true,
        "imagesNewAPICompat": false,
        "partialImages": 1,
        "seed": 41,
        "negativePrompt": "fixture blur",
        "uploadedImageURLs": []
      },
      "expected": {
        "normalizedRequestPolicy": "openai",
        "instructionMode": "verbatim",
        "extendedParameters": false,
        "workerStatus": 200,
        "wire": {
          "url": "https://upstream.example/v1/responses",
          "endpointPath": "/v1/responses",
          "bodyType": "json",
          "body": {
            "model": "fixture-text-model",
            "input": [{ "role": "user", "content": [{ "type": "input_text", "text": "fixture red square" }] }],
            "tools": [{
              "type": "image_generation",
              "model": "fixture-image-model",
              "action": "generate",
              "size": "1024x1024",
              "quality": "auto",
              "output_format": "png",
              "moderation": "low",
              "partial_images": 1
            }],
            "tool_choice": { "type": "image_generation" },
            "reasoning": { "effort": "xhigh" },
            "store": false,
            "stream": true,
            "instructions": "You are a tool runner. Pass the user prompt to image_generation VERBATIM. DO NOT rewrite, expand, polish, or revise it in any way. Use the exact text the user gave."
          }
        }
      }
    },
